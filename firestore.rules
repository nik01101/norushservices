rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Services catalog: Publicly readable, writeable only by authenticated admin
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default availability settings & daily blocks: Publicly readable for booking calendar
    match /availability/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /daily_availability/{dateId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Bookings: Public can submit requests; only authenticated admin can view, update status, or delete
    match /bookings/{bookingId} {
      allow create: if request.resource.data.customerEmail is string 
                    && request.resource.data.customerName is string
                    && request.resource.data.serviceId is string;
      allow read, update, delete: if request.auth != null;
    }

    // Contact messages: Public can submit inquiries; only authenticated admin can view or manage
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.email is string 
                    && request.resource.data.message is string;
      allow read, update, delete: if request.auth != null;
    }

    // Admins metadata collection: Protected, accessible only by authenticated users
    match /admins/{adminId} {
      allow read, write: if request.auth != null;
    }

    // Fallback: Deny any other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
